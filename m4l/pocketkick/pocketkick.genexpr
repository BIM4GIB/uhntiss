// Pocket Kick - gen~ core. Same voice as proto/voice.h (C mirror used for blind design).
// Bass drum with two engines: body 0 "Sine" = sine with a 4 ms knock + exponential pitch sweep, click + noise
// after it; body 1 "303" = saw at the kick pitch into the 303's self-oscillating diode ladder, whose cutoff
// makes the sweep and which the click excites (the acid "303 kick" as its own engine; ladder restarts per hit).
// The amp envelope (hold + decay) is split around the drive: sqrt before (attack saturates), sqrt after.
// Inputs as the Pocket 303 (same js): in1 note  in2 held (unused)  in3 accent  in4 legato (unused)  in5 trig
// Outputs: out1/out2 audio  out3 LED. Params are 0..1 (switches 0/1) for the Daisy pots.
// gen~ rule: function definitions must precede ALL statements, Param/History included.
polyblep(t, dt) {
	r = 0;
	if (t < dt) {
		tt = t / dt;
		r = tt + tt - tt * tt - 1;
	} else if (t > 1 - dt) {
		tt = (t - 1) / dt;
		r = tt * tt + tt + tt + 1;
	}
	return r;
}
bsaw(p, dt) {
	return 2 * p - 1 - polyblep(p, dt);
}
fracp(x) {
	return x - floor(x);
}

Param body(0, min=0, max=1);
Param keytrack(0, min=0, max=1);
Param tune(0.44, min=0, max=1);
Param sweep(0.5, min=0, max=1);
Param sweep_dec(0.4, min=0, max=1);
Param cutoff(0.5, min=0, max=1);
Param resonance(0.7, min=0, max=1);
Param hold(0.3, min=0, max=1);
Param decay(0.25, min=0, max=1);
Param click(0.6, min=0, max=1);
Param mix_noise(0.15, min=0, max=1);
Param noise_dec(0.25, min=0, max=1);
Param drive(0.55, min=0, max=1);
Param tone(0.8, min=0, max=1);
Param accent(0.5, min=0, max=1);
Param volume(0.8, min=0, max=1);

History ph(0);
History trig_s(0);
History acc_note(0);
History tsince(10);
History penv(0);
History kenv(0);
History aenv(0);
History nenv(0);
History cenv(0);
History s1(0);
History s2(0);
History s3(0);
History s4(0);
History fb(0);
History lp_tone(0);
History hp_x(0);
History hp_y(0);

T = 1 / samplerate;

// ---- trigger (one-shot: note-off is ignored); accent latched at the trigger ----
newtrig = (in5 != trig_s) ? 1 : 0;
accn = (newtrig > 0.5) ? ((in3 > 0.5) ? 1 : 0) : acc_note;

// ---- envelopes, all restart at the trigger ----
tau_p = 0.003 * pow(100, sweep_dec);
tau_a = 0.03 * pow(30, decay);
tau_n = 0.005 * pow(40, noise_dec);
hold_s = 0.06 * hold;
tn = (newtrig > 0.5) ? 0 : tsince + T;
pe = ((newtrig > 0.5) ? 1 : penv) * exp(-T / tau_p);
ke = ((newtrig > 0.5) ? 1 : kenv) * exp(-T / 0.004);
ae = (tn < hold_s) ? 1 : ((newtrig > 0.5) ? 1 : aenv) * exp(-T / tau_a);
ne = ((newtrig > 0.5) ? 1 : nenv) * exp(-T / tau_n);
ce = ((newtrig > 0.5) ? 1 : cenv) * exp(-T / 0.003);

// ---- pitch: TUNE 30 .. 120 Hz, optional key tracking from C1; sweep up to 5 oct + 3 oct x CLICK knock ----
semis = (keytrack > 0.5) ? (in1 - 36) : 0;
f0 = 30 * pow(2, 2 * tune) * pow(2, semis / 12);
sw_oct = sweep * 5 * pe + 3 * click * ke;
nz = noise();
transient = newtrig * click + nz * ce * click;

// ---- body ----
a1 = s1;
a2 = s2;
a3 = s3;
a4 = s4;
f = fb;
p = ph;
bodysig = 0;
if (body < 0.5) {
	fosc = f0 * pow(2, sw_oct);
	p = (newtrig > 0.5) ? 0 : fracp(ph + fosc * T);
	bodysig = sin(twopi * p) + transient;
} else {
	if (newtrig > 0.5) {
		a1 = 0;
		a2 = 0;
		a3 = 0;
		a4 = 0;
		f = 0;
	}
	inc = f0 * T;
	p = (newtrig > 0.5) ? 0 : fracp(ph + inc);
	saw = bsaw(p, inc);
	fc = clamp(f0 * pow(2, (cutoff - 0.5) * 2 + sw_oct), 20, 12000);
	k = 3.4 + resonance;
	g = 1 - exp(-twopi * fc / (samplerate * 2));
	for (i = 0; i < 2; i += 1) {
		u = saw * 0.8 + transient * 2 - k * f;
		x = 2 * tanh(0.5 * u);
		a1 = a1 + g * (x - a1);
		a2 = a2 + g * (a1 - a2);
		a3 = a3 + g * (a2 - a3);
		a4n = a4 + g * (a3 - a4);
		f = 0.5 * (a4n + a4);
		a4 = a4n;
	}
	bodysig = tanh(a4 * (1 + 0.25 * k)) * 1.3 + transient * 0.5;
}

// ---- half the amp envelope + accent before the drive ----
env_pre = sqrt(ae) * (1 + 0.5 * accent * accn);
mixed = (bodysig + nz * ne * mix_noise) * env_pre;

// ---- drive (asymmetric tanh), tone lowpass, DC block, the other half of the envelope, volume ----
drv = clamp(drive + 0.3 * accent * accn, 0, 1);
d = 1 + 9 * drv;
bias = 0.15 * drv;
driven = tanh(d * mixed + bias) - tanh(bias);
tf = 200 * pow(2, 6.6 * tone);
lt = lp_tone + (driven - lp_tone) * (1 - exp(-twopi * tf * T));
hp = lt - hp_x + 0.9995 * hp_y;
sig = hp * sqrt(ae) * volume * volume * 0.8;

// ---- write History ----
ph = p;
trig_s = in5;
acc_note = accn;
tsince = tn;
penv = pe;
kenv = ke;
aenv = ae;
nenv = ne;
cenv = ce;
s1 = fixdenorm(a1);
s2 = fixdenorm(a2);
s3 = fixdenorm(a3);
s4 = fixdenorm(a4);
fb = fixdenorm(f);
lp_tone = fixdenorm(lt);
hp_x = lt;
hp_y = fixdenorm(hp);

out1 = sig;
out2 = sig;
out3 = (ae > 0.01) ? 1 : 0;
