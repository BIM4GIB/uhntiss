// Pocket 303 - gen~ core. Same voice as proto/voice.h (C mirror used for blind tuning).
// Inputs:  in1 note (MIDI)  in2 held (0/1)  in3 accent (0/1)  in4 slide (0/1)  in5 trig (counter)
// Outputs: out1/out2 audio  out3 gate (LED)
// Params are all 0..1 so the same patch drives the Daisy pots through Oopsy (hardware/pocket303).
// gen~ rule: function definitions must precede ALL statements, Param/History included.
polyblep(t, dt) {
	r = 0;
	if (t < dt) {
		tt = t / dt;
		r = tt + tt - tt * tt - 1;
	} else if (t > 1 - dt) {
		tt = (t - 1) / dt;
		r = tt * tt + tt + tt + 1;
	}
	return r;
}

Param cutoff(0.3, min=0, max=1);
Param resonance(0.79, min=0, max=1);
Param envmod(0.67, min=0, max=1);
Param decay(0.2, min=0, max=1);
Param accent(0.79, min=0, max=1);
Param tuning(0.5, min=0, max=1);
Param glide(0.3, min=0, max=1);
Param volume(0.8, min=0, max=1);
Param square(0, min=0, max=1);

History ph(0);
History pitch_s(60);
History trig_s(0);
History acc_note(0);
History meg(0);
History acc_raw(0);
History acc_env(0);
History vca_lvl(0);
History vca(0);
History s1(0);
History s2(0);
History s3(0);
History s4(0);
History fb(0);
History hp_x(0);
History hp_y(0);

T = 1 / samplerate;

// ---- note events (the host's js does mono note logic; trig counts note-ons) ----
newtrig = (in5 != trig_s) ? 1 : 0;
legato = (in4 > 0.5) ? 1 : 0;
retrig = newtrig * (1 - legato);
gateon = (in2 > 0.5) ? 1 : 0;
accn = (newtrig > 0.5) ? ((in3 > 0.5) ? 1 : 0) : acc_note;

// ---- slide: RC glide on the note number (12 ms .. 300 ms) ----
slide_tau = 0.012 * pow(25, glide);
pitch = (retrig > 0.5) ? in1 : pitch_s + (in1 - pitch_s) * (1 - exp(-T / slide_tau));
semis = pitch + (tuning - 0.5) * 24;
freq = 440 * pow(2, (semis - 69) / 12);

// ---- oscillator: polyBLEP saw / square ----
inc = freq * T;
p = ph + inc;
p = p - floor(p);
saw = 2 * p - 1 - polyblep(p, inc);
p2 = p + 0.5;
p2 = p2 - floor(p2);
sq = ((p < 0.5) ? 1 : -1) + polyblep(p, inc) - polyblep(p2, inc);
osc = (square > 0.5) ? sq : saw;

// ---- MEG: decay-only filter envelope (30 ms .. 2.4 s); accent forces the fast decay ----
meg_tau = 0.03 * pow(80, decay);
meg_tau = (accn > 0.5) ? min(meg_tau, 0.2) : meg_tau;
m = ((retrig > 0.5) ? 1 : meg) * exp(-T / meg_tau);

// ---- accent sweep: fast decay through a 12 ms RC (the "wow"; stacks on repeats) ----
ar = ((retrig * accn > 0.5) ? 1 : acc_raw) * exp(-T / 0.2);
ae = acc_env + (ar * accent - acc_env) * (1 - exp(-T / 0.012));

// ---- VCA: snap attack (3 ms), slow decay while held (3 s), fast release (10 ms) ----
vl = (retrig > 0.5) ? 1 : vca_lvl;
vl = (gateon > 0.5) ? vl * exp(-T / 3) : 0;
vcoef = (vl > vca) ? (1 - exp(-T / 0.003)) : (1 - exp(-T / 0.010));
va = vca + (vl - vca) * vcoef;
amp = va * (1 + 0.7 * ae);

// ---- cutoff: knob 150 Hz .. 4.8 kHz, envelope up to 2.4 octaves, accent up to +0.5 ----
cut_hz = 150 * pow(2, cutoff * 5);
env_oct = m * envmod * 2.4 + ae * 0.5;
fc = clamp(cut_hz * pow(2, env_oct), 20, 8000);
k = resonance * 4;

// ---- 4-pole ladder, 2x oversampled, soft-saturated input, half-sample feedback ----
g = 1 - exp(-twopi * fc / (samplerate * 2));
a1 = s1;
a2 = s2;
a3 = s3;
a4 = s4;
f = fb;
y = 0;
for (i = 0; i < 2; i += 1) {
	u = osc * 0.5 - k * f;
	x = 2 * tanh(0.5 * u);
	a1 = a1 + g * (x - a1);
	a2 = a2 + g * (a1 - a2);
	a3 = a3 + g * (a2 - a3);
	a4n = a4 + g * (a3 - a4);
	f = 0.5 * (a4n + a4);
	a4 = a4n;
	y = a4;
}

// ---- output: resonance make-up, soft clip, DC block, VCA, volume ----
y = tanh(y * (1 + 0.25 * k));
hp = y - hp_x + 0.997 * hp_y;
sig = hp * amp * volume * volume;

// ---- write History ----
trig_s = in5;
acc_note = accn;
pitch_s = pitch;
ph = p;
meg = m;
acc_raw = ar;
acc_env = ae;
vca_lvl = vl;
vca = va;
s1 = fixdenorm(a1);
s2 = fixdenorm(a2);
s3 = fixdenorm(a3);
s4 = fixdenorm(a4);
fb = fixdenorm(f);
hp_x = y;
hp_y = fixdenorm(hp);

out1 = sig;
out2 = sig;
out3 = gateon;
